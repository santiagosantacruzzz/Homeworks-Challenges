# Copia este archivo como .env.local y pega los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para probar con los emuladores locales de Firebase (firebase emulators:start).
VITE_USE_FIREBASE_EMULATORS=false
